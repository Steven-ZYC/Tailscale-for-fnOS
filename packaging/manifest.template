appname=TailscaleFnos
version=@PACKAGE_VERSION@
display_name=Tailscale
desc=Tailscale 是一款基于 WireGuard 的零配置组网工具。它可将设备放在同一个安全虚拟局域网（Tailnet）内，方便各设备相互链接，并支持 MagicDNS、子网路由、Exit Node 和 Tailscale SSH 等功能。本应用将 Tailscale 官方 Linux 二进制原生封装为 fnOS FPK，由社区维护，与 Tailscale Inc. 及飞牛 fnOS 官方无隶属或背书关系。不支持通过 Tailscale Admin Console 远程或自动升级；请从 GitHub Releases 手动下载新版 FPK，或通过飞牛应用商店更新。项目地址：https://github.com/Steven-ZYC/Tailscale-for-fnOS
source=thirdparty
platform=@FNOS_PLATFORM@

maintainer=Steven Zhang Yancheng
maintainer_url=https://github.com/Steven-ZYC/Tailscale-for-fnOS
distributor=Steven Zhang Yancheng
distributor_url=https://github.com/Steven-ZYC/Tailscale-for-fnOS

desktop_uidir=ui
desktop_applaunchname=TailscaleFnos.main

ctl_stop=true
checkport=false
disable_authorization_path=true
changelog=内置 Tailscale @TAILSCALE_VERSION@ 稳定版；提供原创中文分页管理界面、自动浏览器登录与 Auth Key 登录、账户登出、系统设备图标、设备分页、DERP 延迟、Exit Node、稳定的字体及界面缩放滑块、可键入百分比设置与版本检测；fnOS 打包修订号 @PACKAGE_REVISION@。
