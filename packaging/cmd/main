#!/bin/bash

set -u

APP_NAME="${TRIM_APPNAME:-TailscaleFnos}"
APP_ROOT="/var/apps/${APP_NAME}"
APP_DEST="${TRIM_APPDEST:-${APP_ROOT}/target}"
PKG_VAR="${TRIM_PKGVAR:-${APP_ROOT}/var}"
PKG_TMP="${TRIM_PKGTMP:-${APP_ROOT}/tmp}"
BIN_DIR="${APP_DEST}/bin"
TAILSCALED_BIN="${BIN_DIR}/tailscaled"
TAILSCALE_BIN="${BIN_DIR}/tailscale"
STATE_DIR="${PKG_VAR}/state"
LOG_DIR="${PKG_VAR}/log"
LOG_FILE="${LOG_DIR}/tailscaled.log"
PID_FILE="${PKG_TMP}/tailscaled.pid"
SOCKET_PATH="${PKG_TMP}/tailscaled.sock"

umask 077

write_user_error() {
  local message="$1"
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$message" > "$TRIM_TEMP_LOGFILE"
  fi
  printf '%s\n' "$message" >&2
}

log_message() {
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

prepare_directories() {
  mkdir -p "$STATE_DIR" "$LOG_DIR" "$PKG_TMP" || return 1
  chmod 0700 "$STATE_DIR" "$LOG_DIR" "$PKG_TMP" 2>/dev/null || true
}

read_pid() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid="$(head -n 1 "$PID_FILE" 2>/dev/null)"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s' "$pid"
}

is_our_process() {
  local pid="$1"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1

  # Never trust a cached PID or a process name alone. Match the executable,
  # owner, and package-specific arguments before adopting or stopping it.
  local process_exe expected_exe process_owner argument
  process_owner="$(stat -c '%u' "/proc/${pid}" 2>/dev/null)" || return 1
  [ "$process_owner" = "$(id -u)" ] || return 1
  process_exe="$(readlink "/proc/${pid}/exe" 2>/dev/null)" || return 1
  # An upgrade can replace the file while the previous executable is alive.
  process_exe="${process_exe% (deleted)}"
  expected_exe="$(readlink -f "$TAILSCALED_BIN" 2>/dev/null)" || return 1
  [ -n "$expected_exe" ] && [ "$process_exe" = "$expected_exe" ] || return 1

  local process_state="" process_socket="" process_tun=""
  while IFS= read -r -d '' argument; do
    case "$argument" in
      --statedir=*) process_state="${argument#--statedir=}" ;;
      --socket=*) process_socket="${argument#--socket=}" ;;
      --tun=*) process_tun="${argument#--tun=}" ;;
    esac
  done < "/proc/${pid}/cmdline"
  [ -n "$process_state" ] && [ -n "$process_socket" ] || return 1
  [ "$process_tun" = "tailscale0" ] || return 1

  local expected_state expected_socket
  expected_state="$(readlink -m "$STATE_DIR")" || return 1
  expected_socket="$(readlink -m "$SOCKET_PATH")" || return 1
  process_state="$(readlink -m "$process_state")" || return 1
  process_socket="$(readlink -m "$process_socket")" || return 1
  [ "$process_state" = "$expected_state" ] || return 1
  [ "$process_socket" = "$expected_socket" ] || return 1

  return 0
}

find_our_pid() {
  local pid candidates found=""
  pid="$(read_pid)" || pid=""
  if [ -n "$pid" ] && is_our_process "$pid"; then
    printf '%s' "$pid"
    return 0
  fi

  if command -v pgrep >/dev/null 2>&1; then
    candidates="$(pgrep -x tailscaled 2>/dev/null || true)"
  elif command -v pidof >/dev/null 2>&1; then
    candidates="$(pidof tailscaled 2>/dev/null || true)"
  else
    return 2
  fi
  for pid in $candidates; do
    is_our_process "$pid" || continue
    if [ -n "$found" ]; then
      write_user_error "Multiple daemons match this package; refusing to guess which process to manage."
      return 2
    fi
    found="$pid"
  done
  [ -n "$found" ] || return 1
  printf '%s' "$found"
}

save_pid() {
  local pid="$1" temporary_pid
  mkdir -p "$PKG_TMP" || return 1
  chmod 0700 "$PKG_TMP" || return 1
  temporary_pid="$(mktemp "${PID_FILE}.XXXXXX")" || return 1
  if ! printf '%s\n' "$pid" > "$temporary_pid" ||
     ! chmod 0600 "$temporary_pid" ||
     ! mv -f "$temporary_pid" "$PID_FILE"; then
    rm -f "$temporary_pid"
    return 1
  fi
}

status_app() {
  local pid
  pid="$(find_our_pid)" || {
    local discovery_status=$?
    if [ "$discovery_status" -eq 2 ]; then
      write_user_error "Unable to identify one package daemon safely; runtime files were left intact."
      return 1
    fi
    rm -f "$PID_FILE"
    return 1
  }
  if [ "$(read_pid 2>/dev/null || true)" != "$pid" ]; then
    save_pid "$pid" || return 1
    log_message "Recovered PID tracking for existing package daemon ${pid}."
  fi
  return 0
}

any_tailscaled_running() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x tailscaled >/dev/null 2>&1
    return $?
  fi

  if command -v pidof >/dev/null 2>&1; then
    pidof tailscaled >/dev/null 2>&1
    return $?
  fi

  # Fail closed when the platform has no safe process-discovery command.
  return 0
}

check_conflicts() {
  if [ -e /sys/class/net/tailscale0 ]; then
    write_user_error "A tailscale0 interface already exists. Stop any other Tailscale installation before starting this package."
    return 1
  fi

  if command -v pgrep >/dev/null 2>&1 && pgrep -x tailscaled >/dev/null 2>&1; then
    write_user_error "Another tailscaled process is already running. Stop it before starting this package."
    return 1
  fi

  return 0
}

restore_exit_node_forwarding() {
  local advertised
  advertised="$("$TAILSCALE_BIN" --socket="$SOCKET_PATH" get advertise-exit-node 2>> "$LOG_FILE" || true)"
  [ "$advertised" = "true" ] || return 0

  if [ -w /proc/sys/net/ipv4/ip_forward ]; then
    printf '1\n' > /proc/sys/net/ipv4/ip_forward
  fi
  if [ -w /proc/sys/net/ipv6/conf/all/forwarding ]; then
    printf '1\n' > /proc/sys/net/ipv6/conf/all/forwarding
  fi
  log_message "Restored runtime IP forwarding for the configured Exit Node."
}

start_app() {
  if status_app; then
    if [ ! -S "$SOCKET_PATH" ]; then
      write_user_error "The package daemon is running, but its management socket is missing. Use a local/LAN connection to stop and start this application; restarting can interrupt Tailscale connectivity."
      return 1
    fi
    chmod 0600 "$SOCKET_PATH" 2>/dev/null || true
    return 0
  fi

  if [ "$(id -u)" -ne 0 ]; then
    write_user_error "Tailscale kernel networking must be started as root."
    return 1
  fi

  if [ ! -c /dev/net/tun ]; then
    write_user_error "/dev/net/tun is unavailable. Enable TUN support in fnOS or in the virtual machine configuration."
    return 1
  fi

  if [ ! -x "$TAILSCALED_BIN" ] || [ ! -x "$TAILSCALE_BIN" ]; then
    write_user_error "Tailscale binaries are missing or not executable. Reinstall the application."
    return 1
  fi

  prepare_directories || {
    write_user_error "Unable to create the Tailscale state directory."
    return 1
  }

  check_conflicts || return 1
  rm -f "$SOCKET_PATH" "$PID_FILE"

  log_message "Starting tailscaled from ${TAILSCALED_BIN}."
  nohup "$TAILSCALED_BIN" \
    --statedir="$STATE_DIR" \
    --socket="$SOCKET_PATH" \
    --tun=tailscale0 \
    --port=0 >> "$LOG_FILE" 2>&1 &

  local pid=$!
  if ! save_pid "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    write_user_error "Unable to save the Tailscale PID file."
    return 1
  fi

  local attempt=0
  while [ "$attempt" -lt 15 ]; do
    if ! is_our_process "$pid"; then
      rm -f "$PID_FILE" "$SOCKET_PATH"
      write_user_error "tailscaled exited during startup. Check ${LOG_FILE}."
      return 1
    fi
    if [ -S "$SOCKET_PATH" ]; then
      chmod 0600 "$SOCKET_PATH" 2>/dev/null || true
      restore_exit_node_forwarding
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done

  kill -TERM "$pid" 2>/dev/null || true
  rm -f "$PID_FILE" "$SOCKET_PATH"
  write_user_error "tailscaled did not create its LocalAPI socket within 15 seconds. Check ${LOG_FILE}."
  return 1
}

cleanup_network_state() {
  "$TAILSCALED_BIN" \
    --cleanup \
    --statedir="$STATE_DIR" \
    --socket="$SOCKET_PATH" \
    --tun=tailscale0 >> "$LOG_FILE" 2>&1 || true
}

stop_app() {
  local pid
  pid="$(find_our_pid)" || {
    local discovery_status=$?
    if [ "$discovery_status" -eq 2 ]; then
      write_user_error "Unable to identify one package daemon safely; runtime files were left intact."
      return 1
    fi
    rm -f "$PID_FILE"
    if [ -x "$TAILSCALED_BIN" ] && ! any_tailscaled_running; then
      rm -f "$SOCKET_PATH"
      cleanup_network_state
    else
      log_message "Skipped orphan network cleanup because another tailscaled process may be running."
    fi
    return 0
  }

  if ! is_our_process "$pid"; then
    rm -f "$PID_FILE"
    if ! any_tailscaled_running; then
      rm -f "$SOCKET_PATH"
      cleanup_network_state
    else
      log_message "Skipped stale-PID cleanup because another tailscaled process may be running."
    fi
    return 0
  fi

  log_message "Stopping tailscaled process ${pid}."
  kill -TERM "$pid" 2>/dev/null || true

  local attempt=0
  while is_our_process "$pid" && [ "$attempt" -lt 15 ]; do
    sleep 1
    attempt=$((attempt + 1))
  done

  if is_our_process "$pid"; then
    log_message "tailscaled did not stop after 15 seconds; sending KILL."
    kill -KILL "$pid" 2>/dev/null || true
    attempt=0
    while is_our_process "$pid" && [ "$attempt" -lt 5 ]; do
      sleep 1
      attempt=$((attempt + 1))
    done
    if is_our_process "$pid"; then
      write_user_error "The package daemon could not be stopped; its runtime files were left intact."
      return 1
    fi
  fi

  rm -f "$PID_FILE" "$SOCKET_PATH"
  if ! any_tailscaled_running; then
    cleanup_network_state
  fi
  return 0
}

case "${1:-}" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    write_user_error "Usage: $0 {start|stop|status}"
    exit 1
    ;;
esac
